# Copiar este archivo como ".env" para desarrollo local.
# Los valores de aqui son solo para Docker Compose local, nunca para produccion.

DJANGO_SECRET_KEY=inseguro-solo-para-desarrollo-local
DJANGO_DEBUG=1
# "backend" hace falta porque el proxy de Vite reescribe el Host al
# nombre del servicio dentro de la red de Docker (changeOrigin: true).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=bosphorus_zf
POSTGRES_USER=bosphorus
POSTGRES_PASSWORD=bosphorus_dev_local
POSTGRES_HOST=db
POSTGRES_PORT=5432
